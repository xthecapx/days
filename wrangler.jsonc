{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "days",
  "main": "worker/github-wiki-bridge.js",
  "compatibility_date": "2025-01-01",
  "vars": {
    "GITHUB_REPO": "xthecapx/days"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
