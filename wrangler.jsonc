{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "days",
  "main": "worker/github-wiki-bridge.js",
  "compatibility_date": "2025-01-01",
  "vars": {
    "GITHUB_REPO": "xthecapx/days"
  },
  // Límite de ráfaga por visitante: 3 reportes por minuto. namespace_id debe ser único en tu cuenta.
  "ratelimits": [
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "7421",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
