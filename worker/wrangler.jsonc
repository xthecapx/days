{
  // Report bridge: opens a Pull Request for each neighbour report. Deployed from this folder
  // (in Cloudflare: Root directory = worker). Independent of the signal server (../services/signal).
  "name": "days",
  "main": "github-wiki-bridge.js",
  "compatibility_date": "2025-01-01",
  "vars": {
    "GITHUB_REPO": "xthecapx/days"
  },
  // Burst limit per visitor: 3 reports per minute. namespace_id must be unique in your account.
  "ratelimits": [
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "7421",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
