{
  // Help signal server. Independent of the reports Worker (../../worker/wrangler.jsonc, name "days").
  "name": "days-signal",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,

  "vars": {
    // Pages that may call this server from a browser (comma-separated). Phone Shortcuts
    // do not send "Origin", so they are not affected.
    "ALLOWED_ORIGINS": "https://xthecapx.github.io",
    // Only `npm run dev` sets it to true (allows localhost and the local network). In production, always false.
    "ALLOW_LOCAL": "false"
  },

  "durable_objects": {
    "bindings": [{ "name": "SIGNAL_BOARD", "class_name": "SignalBoard" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalBoard"] }],

  // Rate limits per visitor (IP hash with a secret). The namespace_ids must be unique in your Cloudflare
  // account; the reports Worker uses 7421. Many people share an IP on a mobile network, which is why they are generous.
  "ratelimits": [
    { "name": "SIGNAL_LIMITER", "namespace_id": "7431", "simple": { "limit": 6, "period": 60 } },
    { "name": "POLL_LIMITER", "namespace_id": "7432", "simple": { "limit": 30, "period": 60 } }
  ],

  // Cloudflare logs enabled (Workers Logs): one record per request, to see errors and usage while this is a trial.
  // Our code writes NOTHING to the log (no coordinates, no IP): the coordinates travel in the POST body, not in
  // the URL. Which request metadata Cloudflare adds on its own (e.g. the client IP) I could not confirm.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
