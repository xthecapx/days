{
  "name": "vecinos-rio-del-hato-pixel-map",
  "version": "1.0.0",
  "description": "100% anonymous neighbourhood monitor in 2D pixel art for the Río del Hato trail and Ciudad Tierrabuena",
  "type": "module",
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "map:update": "node scripts/update-map.mjs",
    "test": "node --test --test-timeout=60000 \"tests/**/*.test.js\" \"services/*/test/**/*.test.js\"",
    "signal:dev": "npm run dev --workspace @days/signal",
    "signal:test": "npm test --workspace @days/signal"
  },
  "keywords": [
    "pixel-art",
    "seguridad-vecinal",
    "github-pages",
    "wiki",
    "rio-del-hato"
  ],
  "license": "MIT",
  "devDependencies": {
    "puppeteer-core": "^25.16.0",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
